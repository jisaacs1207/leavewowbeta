# Copy to .env and fill in real values. Do not commit .env.

# MySQL / MariaDB (Plesk database)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=leavewowbeta
DB_USER=leavewowbeta
DB_PASS=

# Cloudflare Turnstile: create/manage widget at
# https://dash.cloudflare.com/?to=/:account/turnstile
# Hostnames must include leavewowbeta.live. Put REAL keys only in server .env
# (Plesk); never commit them. Site key is public-in-browser; secret is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: comma-separated IPs allowed to skip rate limits (empty = none)
RATE_LIMIT_WHITELIST=

# Signatures allowed per IP within RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600

# Public site URL used for share links (no trailing slash)
APP_URL=https://leavewowbeta.live

# Public privacy contact shown in the footer (do not use a personal inbox here)
PRIVACY_CONTACT=privacy@leavewowbeta.live

# Set to 1 in production to hide PHP errors from visitors
APP_DEBUG=0

# Optional pepper for email/IP hashes (defaults to DB_PASS if unset)
HASH_PEPPER=
