# Copy to .env and fill in real values. Do not commit .env.

# MySQL / MariaDB (Plesk database)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=leavewowbeta
DB_USER=leavewowbeta
DB_PASS=

# Cloudflare Turnstile: create/manage widget at
# https://dash.cloudflare.com/?to=/:account/turnstile
# Hostnames must include leavewowbeta.live. Put REAL keys only in server .env
# (Plesk); never commit them. Site key is public-in-browser; secret is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: comma-separated IPs allowed to skip rate limits (empty = none)
RATE_LIMIT_WHITELIST=

# Signatures allowed per IP within RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600

# Public site URL used for share links (no trailing slash)
APP_URL=https://leavewowbeta.live

# Public privacy contact shown in the footer (do not use a personal inbox here)
PRIVACY_CONTACT=privacy@leavewowbeta.live

# Recent character names stay hidden until this real signature count (default 25)
NAMES_PUBLIC_THRESHOLD=25

# Set to 1 in production to hide PHP errors from visitors
APP_DEBUG=0

# Pepper for email/IP hashes. Prefer a long random value distinct from DB_PASS.
# Do not rotate on a live database without migrating existing email_hash rows.
HASH_PEPPER=

# Optional disposable-email helper (fail-open if the API is down). Server-side only.
EMAIL_VERIFIER_ENABLED=1
EMAIL_VERIFIER_URL=https://rapid-email-verifier.fly.dev/api/validate
EMAIL_VERIFIER_TIMEOUT=2
